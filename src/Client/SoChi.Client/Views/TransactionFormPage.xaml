<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SoChi.Client.ViewModels"
             x:Class="SoChi.Client.Views.TransactionFormPage"
             x:DataType="vm:TransactionFormViewModel"
             Title="{Binding Title}">
    <VerticalStackLayout Padding="20" VerticalOptions="Center">
        <Label Text="Màn hình tạo giao dịch"
               HorizontalOptions="Center"
               FontSize="10" />

        <Button Text="+ Đóng Giao Dịch"
                Command="{Binding CloseCommand}" />
    </VerticalStackLayout>
</ContentPage>