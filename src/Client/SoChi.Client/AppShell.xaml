<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SoChi.Client.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SoChi.Client"
    xmlns:views="clr-namespace:SoChi.Client.Views"
    Title="SoChi">

    <TabBar>
        <ShellContent Title="Tổng quan"
                      ContentTemplate="{DataTemplate views:OverviewPage}" />
        <ShellContent Title="Giao dịch"
                      ContentTemplate="{DataTemplate views:TransactionsPage}" />
        <ShellContent Title="Thống kê"
                      ContentTemplate="{DataTemplate views:StatisticsPage}" />
        <ShellContent Title="Danh mục"
                      ContentTemplate="{DataTemplate views:CategoriesPage}" />
        <ShellContent Title="Cài đặt"
                      ContentTemplate="{DataTemplate views:SettingsPage}" />
    </TabBar>
</Shell>
